    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.503.0",
    "motion": "^11.18.2",
    "next": "^15.3.0",
    "next-intl": "^3.26.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "^15.3.0",
