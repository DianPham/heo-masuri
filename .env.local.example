# ============================================================
# Heo & Masuri — Environment Variables
# Copy this file to .env.local and fill in all values.
# Add the same keys to Vercel → Project → Settings → Environment Variables.
# ============================================================

# ── Supabase (get from supabase.com → Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── Discord webhooks (see README §9 for setup) ──────────────────
DISCORD_WEBHOOK_MISSING=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_ANGRY=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_SOS=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_LOGS=https://discord.com/api/webhooks/...
# Phase 1.5 — notebook asks (fires when Heo asks Masuri a question)
DISCORD_WEBHOOK_NOTEBOOK_ASK=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_NOTEBOOK_REVIEW=https://discord.com/api/webhooks/...
# Phase 2 — new channels
DISCORD_WEBHOOK_SURPRISES=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_DATES=https://discord.com/api/webhooks/...

# ── Web Push VAPID keys ─────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=<your-vapid-public-key>
VAPID_PRIVATE_KEY=<your-vapid-private-key>
VAPID_SUBJECT=mailto:dan@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<same-as-VAPID_PUBLIC_KEY>

# ── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://<project>.vercel.app

# ── Claude Code Routine (auto-trigger lesson generation) ────────
# Endpoint: Anthropic → Claude Code → Routines → copy trigger URL
CLAUDE_ROUTINE_ENDPOINT=https://api.anthropic.com/v1/claude_code/routines/<routine-id>/fire
# Token: Anthropic → API keys → create an OAT key scoped to routines
CLAUDE_ROUTINE_TOKEN=sk-ant-oat01-...

# ── Cron auth (shared secret used by Vercel Cron and manual triggers) ──
CRON_SECRET=<random-long-string>

# ── Phase 2: environment discriminator ─────────────────────────
# `staging` → Discord webhook usernames get `[STAGING]` prefix.
# Leave unset or set to `production` for production.
ENVIRONMENT=

# ── Phase 2: Supabase project refs (used by npm run db:types/db:dump) ──
# Production ref (from supabase.com → project URL or settings)
SUPABASE_PROJECT_REF=
# Staging ref (new project created for Phase 2 work)
SUPABASE_STAGING_PROJECT_REF=

# ── Phase 2: iOS Shortcut auth (only used by /api/dates/ideas/shortcut) ──
SHORTCUT_TOKEN_HEO=<random-long-string>
